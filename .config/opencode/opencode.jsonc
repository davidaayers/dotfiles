{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "variant": "max",
  "small_model": "openai/gpt-5.4-mini",
  "agent": {
    "explore": {
      "model": "openai/gpt-6-luna",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-6-luna",
      "variant": "max"
    }
  },
  "plugin": ["./plugin/tab-chroma.ts"],
  // gdscript LSP: bridge needs --project pointing at game/ (project.godot is not
  // at the repo root and the bridge only searches upward). Port is derived from
  // the checkout path so main repo and worktrees don't collide on 6005.
  "lsp": {
    "gdscript": {
      "command": [
        "sh",
        "-c",
        "B=$(command -v godot-lsp-bridge || true); [ -n \"$B\" ] || B=$(ls \"$HOME\"/.local/share/fnm/node-versions/*/installation/bin/godot-lsp-bridge 2>/dev/null | tail -1); D=$(/bin/pwd -P); if [ -f \"$D/game/project.godot\" ]; then exec \"$B\" --project \"$D/game\" --port \"$((6005 + $(printf %s \"$D\" | cksum | awk '{print $1}') % 1000))\"; else exec \"$B\"; fi"
      ],
      "extensions": [
        ".gd",
        ".gdshader"
      ],
      "env": {
        "GODOT_PATH": "/Applications/Godot.app/Contents/MacOS/Godot"
      }
    }
  },
  "permission": {
    "edit": { "/var/folders/**": "allow" },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/folders/**": "allow",
      // local Godot reference clones (engine source @ 4.7.1-stable, docs, demos)
      "~/development/godot/**": "allow"
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash-nothink": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash (no thinking)",
          "reasoning": false,
          "options": {
            "thinking": { "type": "disabled" }
          }
        }
      }
    }
  },
}
