{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "variant": "max",
  "small_model": "opencode-go/mimo-v2.5",
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "low"
    },
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "max"
    }
  },
  "plugin": ["./plugin/tab-chroma.ts"],
  "lsp": {
    "gdscript": {
      "command": [
        "godot-lsp-bridge"
      ],
      "extensions": [
        ".gd",
        ".gdshader"
      ],
      "env": {
        "GODOT_PATH": "/Applications/Godot.app/Contents/MacOS/Godot"
      }
    }
  },
  "permission": {
    "edit": { "/var/folders/**": "allow" },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/folders/**": "allow"
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash-nothink": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash (no thinking)",
          "reasoning": false,
          "options": {
            "thinking": { "type": "disabled" }
          }
        }
      }
    }
  },
}
