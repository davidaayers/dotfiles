{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./plugin/tab-chroma.ts"],
  "lsp": {
    "gdscript": {
      "command": [
        "godot-lsp-bridge"
      ],
      "extensions": [
        ".gd",
        ".gdshader"
      ]
    }
  },
  "permission": {
    "edit": { "/var/folders/**": "allow" },
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/folders/**": "allow"
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash-nothink": {
          "id": "deepseek-v4-flash",
          "name": "DeepSeek V4 Flash (no thinking)",
          "reasoning": false,
          "options": {
            "thinking": { "type": "disabled" }
          }
        }
      }
    }
  },
}
