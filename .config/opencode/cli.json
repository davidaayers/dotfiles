{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "-opencode.sidebar.context",
    "-opencode.prompt.footer",
    "@davidaayers/opencode-context-gauge-plugin@1.0.2",
    "@davidaayers/opencode-go-usage-plugin@1.0.2",
    {
      "package": "@davidaayers/opencode-codex-usage-plugin@1.0.2"
    }
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
