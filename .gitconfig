[alias]
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	co = checkout
	fo = fetch origin
	po = push origin 
	br = branch
	rb = rebase
[push]
	default = simple
	autoSetupRemote = true
[user]
	email = david.ayers@invitationhomes.com
	name = David Ayers
[core]
	pager = less -FRX
	editor = mate -w
[pull]
	rebase = true
[init]
	defaultBranch = main
