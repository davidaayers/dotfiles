#!/usr/bin/env python3
"""Offline session retention for OpenCode V2 (Python standard library only)."""

import argparse
from contextlib import closing
import json
import math
from pathlib import Path
import re
import shutil
import signal
import sqlite3
import subprocess
import sys
import time
from urllib.parse import urlencode


class CleanupError(Exception):
    pass


def run(*args):
    result = subprocess.run(args, text=True, capture_output=True)
    if result.returncode:
        raise CleanupError(f"{' '.join(args)} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def api(path):
    # Never start/reconnect the shared service during offline maintenance.
    # Each private server exits with its CLI invocation.
    return json.loads(run('opencode', 'api', '--standalone', 'get', path))


def assert_idle(db):
    result = subprocess.run(['lsof', '-t', '--', str(db)], text=True,
                            capture_output=True)
    if result.returncode not in (0, 1) or result.stderr.strip():
        raise CleanupError('Unable to check whether the database is in use.')
    if result.stdout.strip():
        raise CleanupError('Database is in use. Quit all OpenCode clients, run '
                           '`opencode service stop`, then retry. Do not launch '
                           'OpenCode until cleanup finishes.')


def list_sessions():
    sessions = {}
    cursor = None
    seen_cursors = set()
    while True:
        params = {'limit': '100', 'order': 'asc'}
        if cursor:
            params['cursor'] = cursor
        page = api('/api/session?' + urlencode(params))
        if not isinstance(page, dict) or not isinstance(page.get('data'), list):
            raise CleanupError('Unexpected V2 session list response.')
        if not isinstance(page.get('cursor'), dict):
            raise CleanupError('Missing V2 pagination information; refusing a partial plan.')
        for session in page['data']:
            if not isinstance(session, dict) or not isinstance(session.get('time'), dict):
                raise CleanupError('Unexpected V2 session fields; refusing cleanup.')
            sid = session.get('id')
            updated = session['time'].get('updated')
            parent = session.get('parentID')
            if (not isinstance(sid, str) or not re.fullmatch(r'ses[a-zA-Z0-9_]+', sid)
                    or isinstance(updated, bool) or not isinstance(updated, (int, float))
                    or not math.isfinite(updated)
                    or (parent is not None and not isinstance(parent, str))):
                raise CleanupError('Unexpected V2 session fields; refusing cleanup.')
            if sid in sessions:
                raise CleanupError('Session list changed during pagination; retry when idle.')
            sessions[sid] = session
        cursor = page['cursor'].get('next')
        if cursor is None:
            return sessions
        if not isinstance(cursor, str) or not cursor or cursor in seen_cursors:
            raise CleanupError('Invalid/repeated pagination cursor; refusing a partial plan.')
        seen_cursors.add(cursor)


def make_plan(sessions, cutoff):
    # Validate the complete forest before relying on cascading deletion.
    checked = set()
    for sid in sessions:
        chain = set()
        current = sid
        while current is not None and current not in checked:
            if current not in sessions or current in chain:
                raise CleanupError('Missing parent or cycle in session list; refusing cleanup.')
            chain.add(current)
            current = sessions[current].get('parentID')
        checked.update(chain)

    keep = set()
    for sid, session in sessions.items():
        if session['time']['updated'] >= cutoff:
            while sid is not None and sid not in keep:
                keep.add(sid)
                sid = sessions[sid].get('parentID')
    candidates = sessions.keys() - keep
    roots = [sid for sid in candidates
             if sessions[sid].get('parentID') not in candidates]
    roots.sort(key=lambda sid: (sessions[sid]['time']['updated'], sid))
    return roots, len(candidates)


def vacuum_database(db):
    assert_idle(db)
    # VACUUM may need approximately one database's worth of temporary space.
    required = db.stat().st_size + 1024 ** 3
    if shutil.disk_usage(db.parent).free < required:
        raise CleanupError('Not enough free space for VACUUM (database size + 1 GiB required).')
    with closing(sqlite3.connect(str(db), timeout=10)) as connection:
        for statement in ('PRAGMA wal_checkpoint(TRUNCATE)', 'VACUUM',
                          'PRAGMA wal_checkpoint(TRUNCATE)'):
            row = connection.execute(statement).fetchone()
            if statement.startswith('PRAGMA') and row[0] != 0:
                raise CleanupError(f'Checkpoint could not complete: {row}')


def main():
    parser = argparse.ArgumentParser(
        description='Delete OpenCode V2 sessions inactive for N rolling days, across all projects.',
        epilog='Quit all clients and run `opencode service stop` before deletion/vacuum. '
               'Back up the database first. Dry runs may run while OpenCode is open.')
    parser.add_argument('--keep-days', type=int, default=5, metavar='N',
                        help='Retain N rolling 24-hour periods (1–36500; default: 5)')
    parser.add_argument('--dry-run', action='store_true', help='Preview only; no deletion or vacuum')
    parser.add_argument('--vacuum', action='store_true', help='Also reclaim database disk space offline')
    args = parser.parse_args()
    if not 1 <= args.keep_days <= 36500:
        parser.error('--keep-days must be an integer from 1 to 36500')
    for dependency in ('opencode', 'lsof'):
        if shutil.which(dependency) is None:
            raise CleanupError(f'Required command not found: {dependency}')
    version = run('opencode', '--version')
    if not re.fullmatch(r'(?:opencode v)?2\.[^\s]+', version):
        raise CleanupError(f'This script supports OpenCode V2, not {version}.')
    db = Path(run('opencode', 'debug', 'paths', 'db')).resolve()
    if not db.is_file():
        raise CleanupError(f'Database does not exist: {db}')
    lock = Path(str(db) + '.cleanup.lock')
    locked = False
    try:
        if not args.dry_run:
            try:
                lock.mkdir()
            except FileExistsError:
                raise CleanupError(f'Cleanup lock exists: {lock}. Check for another cleanup '
                                   'before removing an interrupted run’s empty lock directory.')
            locked = True
            assert_idle(db)
        cutoff = (time.time() - args.keep_days * 86400) * 1000
        sessions = list_sessions()
        roots, count = make_plan(sessions, cutoff)
        print(f'Database: {db}; retention: {args.keep_days} days')
        print(f'{len(sessions)} sessions total; {count} old sessions in '
              f'{len(roots)} deletable subtree(s); {len(sessions) - count} retained.')
        for sid in roots:
            if args.dry_run:
                print(f'Would delete {sid} (including its child sessions)')
            else:
                assert_idle(db)
                print(f'Deleting {sid} (including its child sessions)', flush=True)
                run('opencode', 'session', 'delete', '--standalone', sid)
        if args.dry_run:
            print('Dry run complete: no sessions deleted; database not vacuumed.')
            if args.vacuum:
                print('Would checkpoint and vacuum the database after deletion.')
        elif args.vacuum:
            print('Checkpointing and vacuuming; this may take time.', flush=True)
            vacuum_database(db)
            print('Vacuum complete.')
    finally:
        if locked:
            lock.rmdir()


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(128 + signum))
    try:
        main()
    except (CleanupError, OSError, ValueError, sqlite3.Error) as error:
        print(f'opencode-cleanup: {error}', file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
